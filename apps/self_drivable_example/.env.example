# Browser/mobile API keys are visible to app users. Use this direct setup only for
# local MVP validation; production apps should use a server-side proxy.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=
# Optional OpenAI-compatible proxy endpoint:
EXPO_PUBLIC_OPENAI_BASE_URL=

# DeepSeek (OpenAI-compatible Responses API)
# Expo only exposes variables prefixed EXPO_PUBLIC_.
EXPO_PUBLIC_ACTOUR_MODEL_PROVIDER=deepseek
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-flash
EXPO_PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Actour logs are silent unless this is exactly "true".
EXPO_PUBLIC_ACTOUR_DEBUG=false

{
  "name": "actour",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "start": "pnpm --filter @actour/rn-example start",
    "ios": "pnpm --filter @actour/rn-example ios",
    "android": "pnpm --filter @actour/rn-example android",
    "web": "pnpm --filter @actour/rn-example web",
    "taro:dev": "pnpm --filter @actour/taro-example dev:weapp",
    "taro:build": "pnpm --filter @actour/taro-example build:weapp",
    "agent:start": "pnpm --filter @actour/self-drivable-example start",
    "agent:ios": "pnpm --filter @actour/self-drivable-example ios",
    "agent:test": "pnpm --filter @actour/agent test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
